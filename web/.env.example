# Copy this file to .env.local for local development
# (`cp .env.example .env.local`) and fill in the Clerk publishable key.
# Never put real secrets in a VITE_* variable: Vite inlines them into the
# public bundle.
#
# This must be the SAME publishable key the Worker uses as its
# CLERK_PUBLISHABLE_KEY var (wrangler.jsonc, or .dev.vars locally). The site
# needs it at build time so Clerk can mount; without it the auth pages render
# a "not configured" notice and the landing page still works.

# Production builds (`pnpm build`, `pnpm deploy`) read this from the process
# environment or `web/.env.production` (ignored by git). Set it in CI before
# building.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
