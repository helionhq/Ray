{
  "api": {
    "base_url": "https://ray.helionhq.com"
  },
  "known_names": [
    "Arham",
    "Helion",
    "Ray",
    "Claude",
    "ChatGPT",
    "GPT-5",
    "Gemma",
    "gpt-oss",
    "Grok",
    "Groq",
    "Gemini",
    "Anthropic",
    "OpenAI",
    "Vercel",
    "Tauri",
    "Supabase",
    "Linear",
    "Notion",
    "Kubernetes",
    "PostgreSQL",
    "Next.js",
    "shadcn",
    "Tailwind",
    "TypeScript",
    "GitHub",
    "Slack",
    "Deepgram",
    "AssemblyAI",
    "Typeless",
    "Rust",
    "pnpm"
  ],
  "stt": {
    "prompt": "A work dictation from a software founder, PM or engineer: messages, emails, meeting notes, technical instructions and casual replies. Vocabulary includes AI and developer tools (Claude, ChatGPT, Gemma, gpt-oss, Grok, Groq, Anthropic, OpenAI, Vercel, Tauri, Supabase, Linear, Notion, Kubernetes, PostgreSQL, Next.js, shadcn), the company Helion, teammates' names, and the product Ray. Speech may contain filler words, false starts and self-corrections; transcribe faithfully.",
    "language_codes": ["en"],
    "sample_rate": 16000,
    "force_endpoint_timeout_ms": 2500,
    "keyterms_limit": 100,
    "sync_live": {
      "model": "universal-3-5-pro",
      "max_audio_seconds": 120,
      "request_timeout_ms": 300000
    },
    "batch": {
      "model": "universal-3-5-pro",
      "speech_models": [
        "universal-3-5-pro",
        "universal-2"
      ],
      "timeout_ms": 45000
    }
  },
  "cleanup": {
    "enabled": true,
    "temperature": 0.0,
    "max_tokens": 3000,
    "timeout_ms": 8000,
    "hedge_after_ms": 4000,
    "retries": 2,
    "backoff_ms": [
      300,
      900
    ],
    "providers": [
      {
        "id": "ray",
        "model": "gemma-4-31b"
      }
    ]
  }
}
