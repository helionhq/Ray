{
  "known_names": [
    "ChatGPT",
    "Claude",
    "Claude Code",
    "OpenAI",
    "Anthropic",
    "Gemini",
    "Gemma",
    "Qwen",
    "Kimi",
    "DeepSeek",
    "Llama",
    "Mistral",
    "Codex",
    "Ollama",
    "Hugging Face",
    "OpenRouter",
    "GitHub",
    "Vercel",
    "Supabase",
    "Cloudflare",
    "PostgreSQL",
    "TypeScript",
    "JavaScript",
    "Next.js",
    "Tailwind",
    "Notion",
    "Slack",
    "Linear",
    "Figma",
    "WhatsApp",
    "LinkedIn",
    "YouTube",
    "iPhone",
    "macOS"
  ],
  "stt": {
    "provider": "assemblyai",
    "streaming": true,
    "mode": "sync_live",
    "speech_model": "universal-3-6-pro",
    "prompt": "Dictation of messages, emails, notes, documents and instructions for AI assistants, often with names, products and technical terms. Speech may contain filler words, false starts and self-corrections; transcribe faithfully.",
    "language_codes": [
      "en"
    ],
    "sample_rate": 16000,
    "encoding": "pcm_s16le",
    "format_turns": true,
    "max_turn_silence": 700,
    "end_of_turn_confidence_threshold": 0.4,
    "force_endpoint_timeout_ms": 2500,
    "terminate_timeout_ms": 1800,
    "connect_timeout_ms": 8000,
    "keyterms_limit": 100,
    "sync_live": {
      "endpoint": "https://sync.assemblyai.com/v1/transcribe/live",
      "model": "universal-3-5-pro",
      "max_audio_seconds": 120,
      "request_timeout_ms": 300000
    },
    "batch": {
      "endpoint": "https://sync.assemblyai.com/v1/transcribe",
      "model": "universal-3-5-pro",
      "v2_fallback": true,
      "speech_models": [
        "universal-3-5-pro",
        "universal-2"
      ],
      "poll_interval_ms": 700,
      "timeout_ms": 45000
    }
  },
  "cleanup": {
    "enabled": true,
    "temperature": 0.0,
    "max_tokens": 3000,
    "timeout_ms": 15000,
    "timeout_ms_per_word": 40,
    "hedge_after_ms": 3000,
    "hedge_after_ms_per_word": 8,
    "cold_retry_budget_ms": 60000,
    "cold_retry_delay_ms": 1500,
    "retries": 2,
    "backoff_ms": [
      300,
      900
    ],
    "providers": [
      {
        "id": "rayne-1",
        "base_url": "http://homeserver:8000/v1",
        "model": "rayne-1",
        "api_key_secret": ""
      }
    ]
  }
}
