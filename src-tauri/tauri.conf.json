{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ray",
  "version": "0.1.2",
  "identifier": "com.helion.ray",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ray",
        "url": "index.html",
        "width": 1060,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "bar",
        "title": "Ray",
        "url": "bar.html",
        "width": 304,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Helion",
    "copyright": "Copyright © 2026 Helion",
    "shortDescription": "Fast, clean dictation",
    "longDescription": "Press Right Alt, speak, press it again. Ray transcribes and cleans your speech, then pastes it wherever you are typing.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ray"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3NUIwRTFCQUIyQ0FCNkUKUldSdXF5eXJHdzViRnp2azQyU0RrbmlabFhVUUZWWkZHTlk3NEZhRFl2QmNpb2Y5dnlxM2hnMmEK",
      "endpoints": [
        "https://github.com/helionhq/Ray/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
